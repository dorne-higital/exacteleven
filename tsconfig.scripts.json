{
  // Nuxt's generated project references (see tsconfig.json) don't cover
  // scripts/ or tests/, so `nuxt typecheck` silently skips both. This
  // config gives them real, standalone type coverage.
  "compilerOptions": {
    // "bundler" resolution (not nodenext) to match how tsx actually resolves
    // these files at runtime: extensionless relative imports and imports with
    // an explicit ".ts" extension both need to type-check, since both styles
    // are used across scripts/ and tests/.
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "vitest/globals"],
    // Mirrors vitest.config.ts's own '#shared' alias — needed now that a
    // composable test (tests/useGame.test.ts) transitively imports
    // useStats.ts, which imports shared/daily.ts through this Nuxt-style
    // alias rather than a relative path. No baseUrl needed alongside
    // paths on this TS version (baseUrl is deprecated for TS 7.0).
    "paths": {
      "#shared/*": ["./shared/*"]
    }
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "shared/**/*.ts"]
}
