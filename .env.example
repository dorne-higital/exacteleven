# Signs the draw -> reveal anti-peek token (see server/utils/draw-token.ts).
# Required in any real deployment — the fallback baked into nuxt.config.ts
# is a dev-only placeholder and must not be used in production.
NUXT_DRAW_TOKEN_SECRET=

# Optional. Overrides the canonical/og/sitemap domain in nuxt.config.ts's
# `site.url` — set this once the real Cloudflare Pages project or custom
# domain is confirmed, e.g. https://exact-xi.pages.dev
NUXT_PUBLIC_SITE_URL=

# Optional. The name of a Cloudflare KV namespace bound to the Pages project,
# used to give the rate limiter on /api/draw and /api/reveal a store that's
# actually shared across Workers isolates. Leave unset to keep the in-memory
# default (fine for local dev, not for production).
NUXT_RATE_LIMITER_KV_BINDING=
