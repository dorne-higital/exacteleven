# Signs the draw -> reveal anti-peek token (see server/utils/draw-token.ts).
# Required in any real deployment — the fallback baked into nuxt.config.ts
# is a dev-only placeholder and must not be used in production.
NUXT_DRAW_TOKEN_SECRET=

# Optional. Overrides the canonical/og/sitemap domain in nuxt.config.ts's
# `site.url` (which already defaults to the real production domain) — useful
# for a Netlify deploy-preview URL without editing that file.
NUXT_PUBLIC_SITE_URL=

# Optional, web deploy. Served by /api/app-config to the iOS app: any app
# build number below NUXT_APP_MIN_BUILD is told to update; NUXT_APP_LATEST_BUILD
# is the newest build on the App Store. Both default to 0 (no minimum).
NUXT_APP_MIN_BUILD=
NUXT_APP_LATEST_BUILD=
# The update prompt's button target, e.g. https://apps.apple.com/app/id<APP_STORE_APPLE_ID>
NUXT_APP_STORE_URL=

# Optional, iOS app build only (APP_TARGET=ios). Where the app's API calls go —
# defaults to https://exacteleven.co.uk. Point it at a deploy preview to test
# an API change in the app, or leave it empty-but-set for `yarn dev:app`
# against the local dev server.
# NUXT_PUBLIC_API_BASE=
