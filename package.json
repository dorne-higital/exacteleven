{
  "name": "exacteleven",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:style": "stylelint \"**/*.{css,scss,vue}\"",
    "seed:players": "tsx scripts/seed-players.ts",
    "seed:players:refresh": "tsx scripts/seed-players.ts --fresh",
    "sim:balance": "tsx scripts/simulate.ts",
    "sim:daily": "tsx scripts/simulate-daily.ts",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.1",
    "@nuxt/fonts": "0.14.0",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxtjs/seo": "^5.3.16",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@types/node": "^26.6.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "postcss-html": "^2.0.0",
    "sass": "^1.83.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
